# ==============================================================================
# GLOBAL VARIABLES
# ==============================================================================


# ------------------------------------------------------------------------------
# Ports
# ------------------------------------------------------------------------------

# Ports of our services where the application listens inside the container
# Ports fixed by the images (Keycloak 8080/9000, Postgres 5432, Ollama 11434) stay literal in manifests.
FRONTEND_CONTAINER_PORT=80
PROFILES_CONTAINER_PORT=3000
INFERENCE_CONTAINER_PORT=8000
MOVIES_CONTAINER_PORT=3001


# ------------------------------------------------------------------------------
# Keycloak
# ------------------------------------------------------------------------------

# Terraform specific variables
KEYCLOAK_TERRAFORM_REALM=master
KEYCLOAK_TERRAFORM_CLIENT_ID=terraform

PROFILES_AUDIENCE=profiles-api
INFERENCE_AUDIENCE=inference-api
MOVIES_AUDIENCE=movies-api

# Global keycloak envrionment variables
KEYCLOAK_APP_REALM=agi-project
KEYCLOAK_APP_CLIENT_ID=agi-web

# Master realm information
KEYCLOAK_ADMIN_USER=admin


# ------------------------------------------------------------------------------
# Databases
# ------------------------------------------------------------------------------
# Names only; passwords are in .env.secrets
AUTH_DB_USER=agi-auth-backend
AUTH_DB_NAME=agi-auth-backend
PROFILES_DB_USER=agi-backend
PROFILES_DB_NAME=agi-backend
MOVIES_DB_USER=agi-movies-backend
MOVIES_DB_NAME=agi-movies-backend


# ------------------------------------------------------------------------------
# Movies Service Configuration
# ------------------------------------------------------------------------------
USE_TEMPLATE_DB=true