# ---- Host ports: how we reach a service from outside Docker (browser, curl, psql, terraform)
KEYCLOAK_HOST_PORT=8080
FRONTEND_HOST_PORT=5173
PROFILES_HOST_PORT=3000
INFERENCE_HOST_PORT=8000
OLLAMA_HOST_PORT=11434
AUTH_DB_HOST_PORT=54321
PROFILES_DB_HOST_PORT=54320
MOVIES_HOST_PORT=3001
MOVIES_DB_HOST_PORT=54322

# ---- Container ports of our services: how services reach each other inside Docker
# (http://<service-name>:<port>). Each app must listen on the PORT env var compose sets.
# Ports fixed by the images (Keycloak 8080/9000, Postgres 5432, Ollama 11434) stay literal in compose.
FRONTEND_PORT=80
PROFILES_PORT=3000
INFERENCE_PORT=8000
MOVIES_PORT=3001

# ---- Keycloak
# Terraform specific variables
KEYCLOAK_TERRAFORM_REALM=master
KEYCLOAK_TERRAFORM_CLIENT_ID=terraform

PROFILES_AUDIENCE=profiles-api
INFERENCE_AUDIENCE=inference-api
MOVIES_AUDIENCE=movies-api

# Normal envrionment variables
KEYCLOAK_APP_REALM=agi-project
KEYCLOAK_APP_CLIENT_ID=agi-web

# Master realm information
KEYCLOAK_ADMIN_USER=admin

# ---- Databases (names only; passwords are in .env.secrets)
AUTH_DB_USER=agi-auth-backend
AUTH_DB_NAME=agi-auth-backend
PROFILES_DB_USER=agi-backend
PROFILES_DB_NAME=agi-backend
MOVIES_DB_USER=agi-movies-backend
MOVIES_DB_NAME=agi-movies-backend

# ---- Movies Service Configuration
USE_TEMPLATE_DB=true

