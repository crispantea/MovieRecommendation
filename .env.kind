# ==============================================================================
# KIND VARIABLES
# ==============================================================================


# ------------------------------------------------------------------------------
# Ports
# ------------------------------------------------------------------------------

# External/Host port accessible from our workstation
# (since our microservices are running behind our reverse-proxy, only some of them
# are reachable and the ones that are reachable are only accessible through the reverse-proxy
# entry point, which, in this case, is port 80)
KEYCLOAK_HOST_PORT=80
FRONTEND_HOST_PORT=80

# Kubernetes Service port (internal cluster communication)
KEYCLOAK_SERVICE_PORT=80
#TODO: FILL THIS AND CHANGE THE HARDCODED VALUES ON THE MANIFESTS BY THESE VARS

# ------------------------------------------------------------------------------
# Domains & Routing
# ------------------------------------------------------------------------------

# Domains
KEYCLOAK_DOMAIN=localhost
FRONTEND_DOMAIN=localhost

# Paths
# (our reverse proxy distinguishes the keycloak service using this path)
KEYCLOAK_PATH="/auth"