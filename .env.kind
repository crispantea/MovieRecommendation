# ==============================================================================
# KIND VARIABLES
# ==============================================================================


# ------------------------------------------------------------------------------
# Ports
# ------------------------------------------------------------------------------

# External/Host port accessible from our workstation
# (since our microservices are running behind our reverse-proxy, only some of them
# are reachable and the ones that are reachable are only accessible through the reverse-proxy
# entry point, which, in this case, is port 80)

# Specific values needed because of envrionment agnostic scripts
KEYCLOAK_HOST_PORT=80
FRONTEND_HOST_PORT=80

APP_HOST_PORT=80 # global value used on kind deployments

# Kubernetes Service port (internal cluster communication)
KEYCLOAK_SERVICE_PORT=80
PROFILES_SERVICE_PORT=80
INFERENCE_SERVICE_PORT=80
FRONTEND_SERVICE_PORT=80
MOVIES_SERVICE_PORT=80

# Container port overrides
FRONTEND_CONTAINER_PORT=80 # locally we need to run it on a port different than 80 but when running on k8s we can use 80

# ------------------------------------------------------------------------------
# Domains & Routing
# ------------------------------------------------------------------------------

# Service Names
FRONTEND_SERVICE_NAME=frontend
KEYCLOAK_SERVICE_NAME=keycloak
PROFILES_SERVICE_NAME=profiles-service
INFERENCE_SERVICE_NAME=inference-service
MOVIES_SERVICE_NAME=movies-service

# Namespaces
FRONTEND_NAMESPACE=frontend
KEYCLOAK_NAMESPACE=keycloak
PROFILES_NAMESPACE=profiles-service
INFERENCE_NAMESPACE=inference-service
MOVIES_NAMESPACE=movies-service

# Specific values needed because of envrionment agnostic scripts
KEYCLOAK_DOMAIN=localhost
FRONTEND_DOMAIN=localhost

# Domains
APP_DOMAIN=localhost # global value used on kind deployments

# Paths
# (our reverse proxy distinguishes the keycloak service using this path)
KEYCLOAK_PATH="/auth"
PROFILES_PATH="/placeholder"
INFERENCE_PATH="/placeholder"